# VLM judge, default backend: Alibaba Cloud Model Studio (DashScope / 百炼), model qwen3.8-27b
DASHSCOPE_API_KEY=your-dashscope-api-key
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# MSB_JUDGE_MODEL=qwen3.8-27b

# Self-hosted judge instead (any OpenAI-compatible server, e.g. vLLM serving Qwen3.8-27B):
# MSB_JUDGE_BACKEND=openai
# MSB_JUDGE_URL=http://127.0.0.1:8000/v1
# MSB_JUDGE_MODEL=Qwen3.8-27B
# MSB_JUDGE_API_KEY=EMPTY

# Optional locations (defaults: ./models and ./third_party)
# MSB_MODELS=/path/to/models
# MSB_THIRD_PARTY=/path/to/third_party
